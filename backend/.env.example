# ===========================================
# DataShield Backend - Configuración
# ===========================================
# MODO RECOMENDADO: SQLite local (sin servidor)
# Cada desarrollador tiene su propia BD
DATABASE_URL=file:./dev.db

# MODO COMPARTIDO: PostgreSQL en la nube
# Crear cuenta gratis en https://neon.tech y pegar aquí la conexión:
# DATABASE_URL=postgresql://usuario:pass@ep-xxxx.us-east-2.aws.neon.tech/datashield?sslmode=require

PORT=3000
JWT_SECRET=cambia_esto_en_produccion
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost,https://localhost

# Email (opcional - para notificaciones de estado de reportes)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=tu-email@gmail.com
# EMAIL_PASS=tu-contrasena-app
# EMAIL_FROM="DataShield <no-reply@datashield.com>"