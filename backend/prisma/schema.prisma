generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  password         String
  name             String
  role             String    @default("CITIZEN")
  region           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  reports          Report[]  @relation("UserReports")
  validatedReports Report[]  @relation("ValidatorReports")
}

model Report {
  id                 Int       @id @default(autoincrement())
  title              String
  description        String
  fraudType          String    @default("OTHER")
  phoneNumber        String?
  email              String?
  bankAccount        String?
  url                String?
  socialMediaProfile String?
  region             String?
  anonymous          Boolean   @default(false)
  status             String    @default("PENDING")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  userId             Int
  user               User      @relation("UserReports", fields: [userId], references: [id])
  validatedBy        Int?
  validator          User?     @relation("ValidatorReports", fields: [validatedBy], references: [id])
  compromiseIndicators CompromiseIndicator[]
  evidences          Evidence[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([validatedBy])
  @@index([phoneNumber])
  @@index([email])
  @@index([bankAccount])
  @@index([url])
  @@index([fraudType])
  @@index([region])
}

model Evidence {
  id       Int    @id @default(autoincrement())
  url      String
  reportId Int
  report   Report @relation(fields: [reportId], references: [id])
}

model CompromiseIndicator {
  id          Int      @id @default(autoincrement())
  type        String   @default("phone")
  value       String
  description String?
  reportId    Int
  report      Report   @relation(fields: [reportId], references: [id])

  @@index([type, value])
}

model Alert {
  id        Int      @id @default(autoincrement())
  indicator String
  type      String
  count     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([indicator, type])
}