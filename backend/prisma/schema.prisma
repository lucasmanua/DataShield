generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(CITIZEN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reports      Report[]  @relation("UserReports")
  validatedReports Report[] @relation("ValidatorReports")
}

enum Role {
  ADMIN
  MODERATOR
  CITIZEN
}

model Report {
  id                 Int          @id @default(autoincrement())
  title              String
  description        String
  phoneNumber        String?
  email              String?
  bankAccount        String?
  evidenceUrls       String[]
  status             ReportStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  userId             Int
  user               User         @relation("UserReports", fields: [userId], references: [id])
  validatedBy        Int?
  validator          User?        @relation("ValidatorReports", fields: [validatedBy], references: [id])
  compromiseIndicators CompromiseIndicator[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([validatedBy])
  @@index([phoneNumber])
  @@index([email])
  @@index([bankAccount])
}

enum ReportStatus {
  PENDING
  VALIDATED
  REJECTED
}

model CompromiseIndicator {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  reportId    Int
  report      Report   @relation(fields: [reportId], references: [id])
}